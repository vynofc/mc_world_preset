{
  "schemaVersion": 1,
  "id": "worldpreset",
  "version": "${version}",
  "name": "World Preset Manager",
  "description": "Configure default world presets, datapacks, game rules, and gamemodes through Mod Menu.",
  "authors": ["Nils"],
  "contact": {},
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.example.worldpreset.WorldPresetMod"
    ],
    "modmenu": [
      "com.example.worldpreset.config.WorldPresetModMenu"
    ]
  },
  "mixins": [
    "worldpreset.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "fabric-api": "*",
    "modmenu": ">=20.0.0",
    "java": ">=25"
  }
}