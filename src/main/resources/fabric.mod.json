{
  "schemaVersion": 1,
  "id": "worldpreset",
  "version": "${version}",
  "name": "World Preset Manager",
  "description": "Set default world presets, datapacks, and game rules for new worlds via ingame commands.",
  "authors": ["Nils"],
  "contact": {},
  "license": "MIT",
  "icon": "assets/worldpreset/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.example.worldpreset.WorldPresetMod"
    ]
  },
  "mixins": [
    "worldpreset.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "fabric-api": "*",
    "java": ">=25"
  }
}